import heapq
heuristic = {
    'A': 4,
    'B': 2,
    'C': 1,
    'D': 0
}

def find_a_star_path(graph, start, end):

    queue = []
    heapq.heappush(queue, (0, start, [start], 0))

    while queue:

        f_cost, current, path, g_cost = heapq.heappop(queue)

        if current == end:
            return path, g_cost

        for neighbor, weight in graph[current].items():

            if neighbor not in path:

                new_cost = g_cost + weight

                f = new_cost + heuristic[neighbor]

                heapq.heappush(
                    queue,
                    (f, neighbor, path + [neighbor], new_cost)
                )
haram_graph = {
    'A': {'B': 4, 'C': 2},
    'B': {'D': 5, 'C': 1},
    'C': {'D': 3},
    'D': {}
}
optimal_path, min_total_cost = find_a_star_path(
    haram_graph,
    'A',
    'D'
)

print(f"Optimal Path: {' -> '.join(optimal_path)}")
print(f"Total Cost: {min_total_cost}")
